<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#155FA0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wochen-Übersicht"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budgetübersicht"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_week_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget: 2.000,00 € | Ausgegeben: 0,00 €"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <ProgressBar
                android:id="@+id/progress_week_budget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:max="2000"
                android:progress="0"
                android:progressTint="#6FA8FF"
                android:progressBackgroundTint="#1F4FAE" />

            <TextView
                android:id="@+id/tv_week_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rest: 2.000,00 €"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategorien"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layout_week_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top Ausgaben"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layout_week_payments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_empty_week_payments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Noch keine Ausgaben in dieser Woche"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
